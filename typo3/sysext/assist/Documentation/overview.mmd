  %% ══════════════════════════════════════════
  %% Key relationships (essential flows only)
  %% ══════════════════════════════════════════

  %% 1. Request entry
  AAC -->|"gateClientRequest"| AO
  PAC -->|"checkConnection / getModels"| PCN

  %% 2. Orchestration
  AO -->|"resolves handler"| AIF
  AO -->|"invokes"| AS

  %% 3. Agent execution & persistence
  AS -->|"uses transport"| AG
  PRC -->|"writes to"| DREP
  PRC -->|"creates"| DPR

  %% 4. Platform construction
  PCN -->|"creates"| PB
  PBB -->|"builds"| PB

  %% 5. DI wiring
  ACP -->|"registers into"| AR

  %% 6. Exception hierarchy
  EXP -->|extends| EXB
